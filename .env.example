# ==============================================================================
# HAV_SCRAP: Haveloc Placement Intelligence System - Configuration
# ==============================================================================

# Application Settings
APP_NAME=hav_scrap
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api
PORT=8000
HOST=127.0.0.1

# Security & CORS
# Strictly bind to local frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=sqlite:///./data/hav_scrap.db

# Storage Directories (Absolute or relative to workspace root)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_EXPORTS_DIR=./data/exports
LOGS_DIR=./logs

# Playwright Browser Configuration
# Custom directory to store Playwright browser binaries (keeps installation isolated)
PLAYWRIGHT_BROWSERS_PATH=D:\Development\hav_scrap_browsers
PLAYWRIGHT_HEADLESS=False
PLAYWRIGHT_SLOW_MO=100
PLAYWRIGHT_TIMEOUT=30000

# Persistent Browser Profile
BROWSER_PROFILE_DIR=./data/browser_profile

# Haveloc Portal Settings (Phase 5 Authentication)
HAVELOC_LOGIN_URL=https://haveloc.com/
HAVELOC_TARGET_DASHBOARD_URL=https://placements.haveloc.com/jobs?sort=jobApplyBy%2Cdesc&jobView=eligible

